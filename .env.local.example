# MongoDB connection string (Atlas free M0 cluster works great).
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/pulse-crm?retryWrites=true&w=majority
MONGODB_URI=

# Gemini API key from https://aistudio.google.com/apikey (no credit card needed)
GEMINI_API_KEY=

# Optional: override the default model (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
